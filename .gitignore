# Virtual environment
venv/
.venv/
env/

# Environment variables (contains API keys)
.env
.streamlit/secrets.toml

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore raw captured notes (private JSON payloads)
raw/*
!raw/.gitkeep

# Ignore temporary scraped domain folders and obsidian configs in wiki
wiki/en.wikipedia.org/
wiki/upload.wikimedia.org/
wiki/.obsidian/

# Ignore docs folder as requested by the user
docs/

# Ignore local embeddings cache data & temporary html preview
data/
graph_viewer.html
