# Virtual environment
venv/
.venv/
env/

# Environment variables (contains API keys)
.env
.streamlit/secrets.toml

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore raw captured notes (private user data)
raw/*
!raw/.gitkeep

# Ignore classified wiki notes (private user data)
wiki/*
!wiki/.gitkeep
!wiki/Projects/.gitkeep
!wiki/Areas/.gitkeep
!wiki/Resources/.gitkeep
!wiki/Archives/.gitkeep

# Ignore local embeddings cache data
data/
graph_viewer.html
